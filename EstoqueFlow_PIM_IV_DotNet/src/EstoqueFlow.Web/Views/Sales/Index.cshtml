@model IEnumerable<EstoqueFlow.Web.Models.SalesOrder>
@{ ViewData["Title"] = "Pedidos de venda"; }
<div class="page-intro"><div><h1>Pedidos de venda</h1><p>Registre pedidos e confirme a saída dos produtos após a validação.</p></div><a class="btn btn-primary btn-sm px-3 py-2" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Novo pedido</a></div>
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="panel-card"><div class="panel-title"><h2>Pedidos registrados</h2><small>@Model.Count() pedido(s)</small></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Pedido</th><th>Data</th><th>Cliente</th><th>Produto</th><th>Qtd.</th><th>Total</th><th>Status</th><th>Ação</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>#@x.Id</td><td>@x.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@x.Customer?.Name</td><td>@x.Product?.Name</td><td>@x.Quantity</td><td>@x.Total.ToString("C")</td><td>@if(x.Status=="Concluída"){<span class="status-ok">Concluída</span>}else{<span class="status-low">Pendente</span>}</td><td>@if(x.Status=="Pendente"){<form asp-action="Complete" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-primary" onclick="return confirm('Confirmar venda e baixar o estoque?')"><i class="bi bi-check2-circle"></i> Confirmar</button></form>}else{<span class="text-secondary small">Concluída</span>}</td></tr>}
@if(!Model.Any()){<tr><td colspan="8" class="text-center text-secondary py-5">Nenhum pedido de venda registrado.</td></tr>}
</tbody></table></div></div>
