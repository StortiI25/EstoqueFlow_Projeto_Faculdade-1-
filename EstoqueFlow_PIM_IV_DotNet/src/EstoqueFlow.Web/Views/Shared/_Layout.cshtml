@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool IsActive(string controller, string? action = null) =>
        currentController == controller && (action == null || currentAction == action);
    var currentUserName = User.Identity?.Name ?? "Usuário";
    var avatarText = currentUserName.Length >= 2 ? currentUserName[..2].ToUpperInvariant() : currentUserName.ToUpperInvariant();
    var isAdmin = User.IsInRole("Administrador");
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - EstoqueFlow ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/erp.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="erp-shell">
        <aside class="erp-sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-box-seam"></i></span>
                <span class="brand-copy"><strong>EstoqueFlow</strong><small>ERP • Gestão integrada</small></span>
            </a>
            <div class="sidebar-caption">ÁREA DE TRABALHO</div>
            <a class="side-link @(IsActive("Home") ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Painel inicial</span></a>
            <div class="sidebar-caption">GESTÃO EMPRESARIAL</div>
            <div class="side-group-title"><i class="bi bi-boxes"></i> Estoque</div>
            <a class="side-link side-child @(IsActive("Products") ? "active" : "")" asp-controller="Products" asp-action="Index"><i class="bi bi-box"></i><span>Produtos</span></a>
            <a class="side-link side-child @(IsActive("Stock") ? "active" : "")" asp-controller="Stock" asp-action="Index"><i class="bi bi-arrow-left-right"></i><span>Movimentações</span></a>
            <div class="side-group-title"><i class="bi bi-cart3"></i> Suprimentos</div>
            <a class="side-link side-child @(IsActive("Purchases") ? "active" : "")" asp-controller="Purchases" asp-action="Index"><i class="bi bi-cart-plus"></i><span>Pedidos de compra</span></a>
            <a class="side-link side-child @(IsActive("Suppliers") ? "active" : "")" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i><span>Fornecedores</span></a>
            <div class="side-group-title"><i class="bi bi-people"></i> Relacionamento</div>
            <a class="side-link side-child @(IsActive("Customers") ? "active" : "")" asp-controller="Customers" asp-action="Index"><i class="bi bi-person-vcard"></i><span>Clientes</span></a>
            <a class="side-link side-child @(IsActive("Sales") ? "active" : "")" asp-controller="Sales" asp-action="Index"><i class="bi bi-receipt"></i><span>Pedidos de venda</span></a>
            <div class="sidebar-caption">ANÁLISES E ADMINISTRAÇÃO</div>
            <a class="side-link @(IsActive("Reports") ? "active" : "")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i><span>Relatórios</span></a>
            @if (isAdmin)
            {
                <a class="side-link @(IsActive("Employees") ? "active" : "")" asp-controller="Employees" asp-action="Index"><i class="bi bi-person-gear"></i><span>Funcionários</span></a>
                <a class="side-link @(IsActive("Settings") ? "active" : "")" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i><span>Configurações</span></a>
            }
            <div class="sidebar-bottom"><div class="environment-tag"><span></span> Ambiente acadêmico</div><small>EstoqueFlow ERP • PIM IV</small></div>
        </aside>
        <main class="erp-main">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" type="button" aria-label="Abrir menu" onclick="document.body.classList.toggle('sidebar-open')"><i class="bi bi-list"></i></button>
                    <div><div class="breadcrumb-label">EstoqueFlow <span>/</span> @ViewData["Title"]</div><div class="page-heading">@ViewData["Title"]</div></div>
                </div>
                <div class="topbar-right">
                    <span class="system-status"><span></span> Sistema local</span>
                    <div class="user-chip">
                        <span class="user-avatar">@avatarText</span>
                        <span><strong>@currentUserName</strong><small>@(isAdmin ? "Administrador" : "Funcionário")</small></span>
                    </div>
                    <div class="user-actions">
                        <a asp-controller="Auth" asp-action="ChangePassword" class="user-action-link" title="Alterar senha"><i class="bi bi-key"></i></a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                        <button class="user-action-link" type="submit" title="Sair"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    </div>
                </div>
            </header>
            <section class="workspace">
                @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
                @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
                @RenderBody()
                <footer class="workspace-footer"><span>EstoqueFlow ERP</span><span>Projeto Integrado Multidisciplinar IV • UNIP</span></footer>
            </section>
        </main>
    </div>
    <div class="sidebar-overlay" onclick="document.body.classList.remove('sidebar-open')"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
