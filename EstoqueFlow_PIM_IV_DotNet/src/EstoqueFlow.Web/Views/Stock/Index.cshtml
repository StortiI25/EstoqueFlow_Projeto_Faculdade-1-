@using EstoqueFlow.Web.Models
@{ ViewData["Title"] = "Movimentações"; var products = (IEnumerable<Product>)ViewBag.Products; var movements = (IEnumerable<StockMovement>)ViewBag.Movements; }
<div class="page-intro">
    <div><h1>Movimentação de estoque</h1><p>Registre entradas e saídas e acompanhe o histórico das operações.</p></div>
    <span class="badge text-bg-light border text-secondary fw-normal p-2">Controle de saldo</span>
</div>
@if (TempData["Success"] is string ok) { <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@ok</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i>@error</div> }

<div class="panel-card mb-4">
    <div class="panel-title"><h2>Nova movimentação</h2><small>Preencha os dados da operação</small></div>
    @if (!products.Any())
    {
        <div class="alert alert-warning mb-0">Cadastre um produto antes de registrar uma movimentação. <a asp-controller="Products" asp-action="Create">Cadastrar produto</a></div>
    }
    else
    {
        <form asp-action="Register" method="post">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label for="productId">Produto</label>
                    <select id="productId" name="productId" class="form-select" required>
                        @foreach(var p in products){<option value="@p.Id">@p.Name — saldo atual: @p.Quantity</option>}
                    </select>
                </div>
                <div class="col-lg-2">
                    <label for="type">Operação</label>
                    <select id="type" name="type" class="form-select"><option value="ENTRY">Entrada</option><option value="EXIT">Saída</option></select>
                </div>
                <div class="col-lg-2">
                    <label for="quantity">Quantidade</label>
                    <input id="quantity" name="quantity" type="number" min="1" class="form-control" placeholder="Ex.: 10" required />
                </div>
                <div class="col-lg-3">
                    <label for="notes">Observação</label>
                    <input id="notes" name="notes" class="form-control" placeholder="Motivo ou referência" />
                </div>
                <div class="col-lg-1 d-grid">
                    <button class="btn btn-primary" title="Registrar"><i class="bi bi-check-lg"></i></button>
                </div>
            </div>
        </form>
    }
</div>

<div class="panel-card">
    <div class="panel-title"><h2>Histórico de movimentações</h2><small>Últimos 100 registros</small></div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Data e hora</th><th>Produto</th><th>Tipo</th><th>Quantidade</th><th>Observação</th></tr></thead>
            <tbody>
            @foreach(var m in movements)
            {
                <tr>
                    <td>@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td><strong>@m.Product?.Name</strong></td>
                    <td>@if(m.Type == "ENTRY"){<span class="status-ok">Entrada</span>}else{<span class="status-low">Saída</span>}</td>
                    <td>@m.Quantity</td>
                    <td>@(string.IsNullOrWhiteSpace(m.Notes) ? "—" : m.Notes)</td>
                </tr>
            }
            @if (!movements.Any())
            {
                <tr><td colspan="5" class="text-center text-secondary py-5"><i class="bi bi-clock-history fs-3 d-block mb-2"></i>Nenhuma movimentação registrada.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
