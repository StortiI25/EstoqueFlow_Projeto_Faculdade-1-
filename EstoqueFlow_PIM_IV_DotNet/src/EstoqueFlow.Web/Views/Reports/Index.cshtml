@using EstoqueFlow.Web.Models
@{ ViewData["Title"] = "Relatórios"; var low = (IEnumerable<Product>)ViewBag.LowStock; var movements = (IEnumerable<StockMovement>)ViewBag.Movements; }
<div class="page-intro"><div><h1>Relatórios gerenciais</h1><p>Indicadores resumidos para acompanhamento do estoque e das operações.</p></div><span class="badge text-bg-light border text-secondary fw-normal p-2">Dados atuais do banco</span></div>
<div class="row g-3 mb-4">
<div class="col-md-4"><div class="metric-card"><div class="metric-top">Produtos cadastrados<span class="metric-icon"><i class="bi bi-box"></i></span></div><div class="metric-value">@ViewBag.ProductCount</div></div></div>
<div class="col-md-4"><div class="metric-card"><div class="metric-top">Pedidos de compra<span class="metric-icon"><i class="bi bi-cart3"></i></span></div><div class="metric-value">@ViewBag.PurchaseCount</div></div></div>
<div class="col-md-4"><div class="metric-card"><div class="metric-top">Valor estimado em estoque<span class="metric-icon"><i class="bi bi-currency-dollar"></i></span></div><div class="metric-value" style="font-size:21px">@(((decimal)ViewBag.StockValue).ToString("C"))</div></div></div>
<div class="col-md-4"><div class="metric-card"><div class="metric-top">Vendas concluídas<span class="metric-icon"><i class="bi bi-receipt"></i></span></div><div class="metric-value">@ViewBag.SalesCount</div><div class="metric-foot">Valor concluído: @(((decimal)ViewBag.CompletedSalesValue).ToString("C"))</div></div></div>
</div>
<div class="panel-card mb-4"><div class="panel-title"><h2>Produtos com estoque baixo</h2><small>@low.Count() item(ns)</small></div><div class="table-responsive"><table class="table"><thead><tr><th>Produto</th><th>Saldo atual</th><th>Estoque mínimo</th><th>Diferença</th></tr></thead><tbody>@foreach(var p in low){<tr><td>@p.Name</td><td>@p.Quantity</td><td>@p.MinimumStock</td><td><span class="status-low">@(p.MinimumStock-p.Quantity) abaixo</span></td></tr>}@if(!low.Any()){<tr><td colspan="4" class="text-center text-secondary py-4">Nenhum produto com estoque baixo.</td></tr>}</tbody></table></div></div>
<div class="panel-card"><div class="panel-title"><h2>Movimentações recentes</h2><small>Últimos 50 registros</small></div><div class="table-responsive"><table class="table"><thead><tr><th>Data</th><th>Produto</th><th>Tipo</th><th>Quantidade</th><th>Observação</th></tr></thead><tbody>@foreach(var m in movements){<tr><td>@m.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@m.Product?.Name</td><td>@(m.Type=="ENTRY"?"Entrada":"Saída")</td><td>@m.Quantity</td><td>@m.Notes</td></tr>}@if(!movements.Any()){<tr><td colspan="5" class="text-center text-secondary py-4">Sem movimentações registradas.</td></tr>}</tbody></table></div></div>
